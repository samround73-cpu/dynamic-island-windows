<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island"
        Width="740" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White"
        UseLayoutRounding="True">

    <!--
        The window is a large, fully transparent area along the top-centre of the screen.
        Transparent pixels let clicks pass straight through to whatever is underneath,
        so only the black island inside it is actually clickable.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="Accent" Color="#FFD6B46A" />
        <SolidColorBrush x:Key="AccentText" Color="#FF1F1A0E" />
        <!-- Shades of the accent colour; replaced in code when you pick another colour in Settings -->
        <SolidColorBrush x:Key="AccentSoft" Color="#FF2F2A1C" />
        <SolidColorBrush x:Key="AccentBright" Color="#FFE2C47C" />
        <SolidColorBrush x:Key="AccentFaint" Color="#33D6B46A" />
        <LinearGradientBrush x:Key="AccentHoverGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Offset="0" Color="#46D6B46A" />
            <GradientStop Offset="0.85" Color="#00D6B46A" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBrush" Color="#FF171717" />
        <!-- Surfaces that change with the island style (set in ApplyIslandStyle) -->
        <SolidColorBrush x:Key="FieldBrush" Color="#FF1E1E1E" />
        <SolidColorBrush x:Key="CardBorder" Color="Transparent" />
        <SolidColorBrush x:Key="TileBrush" Color="#FF1C1C1E" />
        <LinearGradientBrush x:Key="ListFadeTop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ListFadeBottom" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="1" Color="#FF000000" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TileHoverBrush" Color="#FF2A2A2D" />
        <SolidColorBrush x:Key="SubtleText" Color="#99FFFFFF" />

        <!-- A flat, rounded button that lights up on hover -->
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A card-coloured button with a hover glow that works on any background (used for power & chips) -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <Grid>
                                <Border x:Name="Glow" CornerRadius="16" Background="Transparent" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#16FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

<!-- A round card-coloured button (Power tab: lock, sleep, sign out) -->
        <Style x:Key="RoundCardButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <Ellipse x:Name="Glow" Fill="White" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.09" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.16" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <!-- The cream circular play button -->
        <!-- Round play button whose colour comes from Background (the Media tab tints it to the artwork) -->
        <Style x:Key="TintPlayButton" TargetType="Button">
            <Setter Property="Background" Value="#FFF1EADB" />
            <Setter Property="Foreground" Value="#FF1F1A0E" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <Ellipse x:Name="Shine" Fill="White" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.15" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF1F1A0E" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="#FFF1EADB" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tabs along the top -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="GroupName" Value="IslandTabs" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="#DDFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small pill choices (clipboard filters, hover delay, °C/°F) -->
<!-- A section in the Settings sidebar: subtle until chosen, then accent-tinted -->
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="10,8" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFaint}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style x:Key="ChipRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="9" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off switch (Settings) -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="11" Background="#FF333333" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A clickable keyboard hint at the bottom of the Clipboard tab ("Ctrl C  Copy") -->
        <Style x:Key="KeyHint" TargetType="Button">
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Padding="3,2,6,2">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FF262626" CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="10" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                </Border>
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" TextElement.FontSize="11" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="Margin" Value="6,14,0,6" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <!-- Slim white slider (song position, media volume) -->
        <Style x:Key="SliderPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderPart}" Background="{TemplateBinding Foreground}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderPart}" Background="#33FFFFFF" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chunky gold volume bar -->
        <Style x:Key="BigSliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{DynamicResource Accent}" CornerRadius="16,0,0,16" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BigSliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BigSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="32">
                            <Border Background="#FF262626" CornerRadius="16" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource BigSliderFill}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource BigSliderEmpty}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="32">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Accent}" CornerRadius="0,16,16,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A button with no chrome except a soft hover glow (hover-tray icons) -->
        <Style x:Key="PeekButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An open app as a chip (Apps tab, under the search box): icon + short name (+ window count).
             The app you're in gets a soft accent tint and outline; minimised apps are faded. -->
        <DataTemplate x:Key="OpenChipTemplate" DataType="{x:Type local:AppTile}">
            <Button x:Name="ChipButton" Style="{StaticResource PeekButton}" Margin="0,0,6,6"
                    Click="AppTile_Click" MouseEnter="Tile_MouseEnter" MouseLeave="Tile_MouseLeave">
                <Button.ContextMenu>
                    <ContextMenu Opened="Menu_Opened" Closed="Menu_Closed">
                        <MenuItem Header="New window" Click="TileNewWindow_Click" />
                        <MenuItem Header="Close" Click="TileClose_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Border x:Name="Chip" Height="30" CornerRadius="15" Padding="9,0,12,0" Background="{DynamicResource FieldBrush}"
                        BorderBrush="Transparent" BorderThickness="1">
                    <StackPanel x:Name="ChipContent" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="18" Height="18">
                            <Image x:Name="Icon" Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="LineGlyph" Text="{Binding Line.Glyph}" Foreground="{Binding Line.Brush}" FontSize="16"
                                       FontFamily="{x:Static local:LineIcons.FontOrDefault}" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding ShortName}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"
                                   MaxWidth="130" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Count}" FontSize="11" Foreground="#80FFFFFF" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding HasMany, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLine}" Value="True">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="LineGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                    <Setter TargetName="ChipContent" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <Trigger SourceName="ChipButton" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource TileHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentFaint}" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A small app icon (hover tray, right-hand side of the "now using" line) -->
        <DataTemplate x:Key="SmallAppIconTemplate" DataType="{x:Type local:AppTile}">
            <Button x:Name="IconButton" Style="{StaticResource PeekButton}" Width="30" Height="30" Margin="1,0"
                    Click="AppTile_Click" MouseEnter="Tile_MouseEnter" MouseLeave="Tile_MouseLeave" ToolTip="{Binding Name}">
                <Button.ContextMenu>
                    <ContextMenu Opened="Menu_Opened" Closed="Menu_Closed">
                        <MenuItem Header="New window" Click="TileNewWindow_Click" />
                        <MenuItem Header="Close" Click="TileClose_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid x:Name="Holder" Width="30" Height="30" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Border x:Name="HoverBg" CornerRadius="9" Background="Transparent" />
                    <Image x:Name="Icon" Source="{Binding Icon}" Width="19" Height="19" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="LineGlyph" Text="{Binding Line.Glyph}" Foreground="{Binding Line.Brush}" FontSize="19"
                               FontFamily="{x:Static local:LineIcons.FontOrDefault}" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border MinWidth="13" Height="13" CornerRadius="6.5" Background="#FF3A3A3C" BorderBrush="#FF151515" BorderThickness="1.5" Padding="2,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-2,0"
                            Visibility="{Binding HasMany, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Count}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLine}" Value="True">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="LineGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                    <Setter TargetName="Icon" Property="Opacity" Value="0.45" />
                    <Setter TargetName="LineGlyph" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <Trigger SourceName="IconButton" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverBg" Property="Background" Value="#1AFFFFFF" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Apps list: section headings -->
        <DataTemplate DataType="{x:Type local:AppSectionHeader}">
            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="#B3FFFFFF" Margin="10,14,0,6" />
        </DataTemplate>

        <!-- Apps list: one app. Gold dot + "Open" when it's running; star to favourite it. -->
        <DataTemplate DataType="{x:Type local:AppRow}">
            <Border x:Name="Row" Height="40" CornerRadius="12" Background="Transparent" Margin="0,1" Cursor="Hand"
                    MouseLeftButtonUp="AppRow_Click" MouseUp="AppRow_MouseUp" MouseEnter="AppRow_MouseEnter">
                <Border.ContextMenu>
                    <ContextMenu Opened="Menu_Opened" Closed="Menu_Closed">
                        <MenuItem Header="Open new window" Click="AppRowNewWindow_Click" />
                        <MenuItem Header="Star / unstar" Click="AppRowStar_Click" />
                        <MenuItem Header="Close all its windows" Click="AppRowClose_Click"
                                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="8,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HoverBar" Width="3" Height="18" CornerRadius="1.5" Background="{DynamicResource Accent}"
                            HorizontalAlignment="Left" Margin="-6,0,0,0" Opacity="0" />
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource FieldBrush}" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="RowInitial" Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold" Foreground="#99FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="RowImage" Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="RowGlyph" Text="{Binding Line.Glyph}" Foreground="{Binding Line.Brush}" FontSize="17"
                                       FontFamily="{x:Static local:LineIcons.FontOrDefault}" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="12,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="Open" FontSize="11" Foreground="{StaticResource SubtleText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="Star" Grid.Column="3" Style="{StaticResource IslandButton}" Width="28" Height="28" Opacity="0"
                            Click="Star_Click" ToolTip="Star">
                        <TextBlock x:Name="StarGlyph" Style="{StaticResource Glyph}" FontSize="12" Text="&#xE734;" Foreground="#99FFFFFF" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLine}" Value="True">
                    <Setter TargetName="RowImage" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RowGlyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RowInitial" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentHoverGradient}" />
                    <Setter TargetName="HoverBar" Property="Opacity" Value="1" />
                    <Setter TargetName="Star" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}" />
                    <Setter TargetName="HoverBar" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStarred}" Value="True">
                    <Setter TargetName="StarGlyph" Property="Text" Value="&#xE735;" />
                    <Setter TargetName="StarGlyph" Property="Foreground" Value="{DynamicResource Accent}" />
                    <Setter TargetName="Star" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One row of the "heaviest open apps" list on the Stats tab -->
        <DataTemplate x:Key="AppUsageTemplate" DataType="{x:Type local:AppUsage}">
            <Grid Margin="6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="20" HorizontalAlignment="Left">
                    <Image x:Name="UsageIcon" Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="UsageGlyph" Text="{Binding Line.Glyph}" Foreground="{Binding Line.Brush}" FontSize="17"
                               FontFamily="{x:Static local:LineIcons.FontOrDefault}" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Grid Grid.Column="2" Height="6" Margin="8,0,4,0" VerticalAlignment="Center">
                    <Border Background="#1FFFFFFF" CornerRadius="3" />
                    <Border Background="{DynamicResource Accent}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Fraction}" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock Grid.Column="3" Text="{Binding CpuText}" FontSize="12" Foreground="{StaticResource SubtleText}"
                           TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding MemoryText}" FontSize="12" Foreground="{StaticResource SubtleText}"
                           TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLine}" Value="True">
                    <Setter TargetName="UsageIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="UsageGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A full-width card row button (clipboard items) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                            <Grid>
                                <Border x:Name="Glow" CornerRadius="14" Background="Transparent" />
                                <ContentPresenter Margin="10,8,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One copied item in the Clipboard tab: type icon, one-line preview, how long ago -->
        <DataTemplate DataType="{x:Type local:ClipItem}">
            <Border x:Name="Row" Height="34" CornerRadius="10" Margin="0,1" Background="Transparent" Cursor="Hand"
                    MouseLeftButtonDown="ClipRow_MouseDown">
                <Grid Margin="6,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBox" Width="24" Height="24" CornerRadius="7" Background="#FF262626" VerticalAlignment="Center">
                        <TextBlock x:Name="IconGlyph" Style="{StaticResource Glyph}" FontSize="11" Text="{Binding Glyph}" Foreground="#CCFFFFFF" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Preview}" FontSize="12.5" FontWeight="SemiBold" Margin="10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Ago}" FontSize="10.5" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#12FFFFFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}" />
                    <Setter TargetName="IconBox" Property="Background" Value="{DynamicResource Accent}" />
                    <Setter TargetName="IconGlyph" Property="Foreground" Value="{DynamicResource AccentText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A file on the shelf: thumbnail, name, details; drag it out to use it -->
        <DataTemplate x:Key="ShelfTileTemplate" DataType="{x:Type local:ShelfItem}">
            <Border x:Name="Tile" Width="112" Height="112" Margin="3" CornerRadius="14" Background="#FF171717" Cursor="Hand"
                    ToolTip="{Binding Path}" MouseLeftButtonDown="ShelfTile_MouseDown" MouseMove="ShelfTile_MouseMove">
                <Border.ContextMenu>
                    <ContextMenu Opened="Menu_Opened" Closed="Menu_Closed">
                        <MenuItem Header="Open" Click="ShelfOpen_Click" />
                        <MenuItem Header="Show in folder" Click="ShelfShowInFolder_Click" />
                        <MenuItem Header="Copy path" Click="ShelfCopyPath_Click" />
                        <Separator />
                        <MenuItem Header="Remove from shelf" Click="ShelfRemove_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel VerticalAlignment="Center" Margin="8,0">
                    <Image Source="{Binding Thumbnail}" Width="48" Height="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="#FF222222" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid>
        <!--
            IslandHost = the island plus two small curved "shoulders" either side of it,
            which make it look like it flows out of the top edge of the screen.
            Its width/height are animated; IslandSlide moves it up out of sight when auto-hiding.
        -->
        <Grid x:Name="IslandHost" HorizontalAlignment="Center" VerticalAlignment="Top"
              Width="264" Height="38" Cursor="Hand" AllowDrop="True" SizeChanged="IslandHost_SizeChanged"
              MouseLeftButtonUp="Island_Click" MouseWheel="Island_MouseWheel"
              DragEnter="Island_DragOver" DragOver="Island_DragOver" DragLeave="Island_DragLeave" Drop="Island_Drop">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="IslandSlide" Y="0" />
            </Grid.RenderTransform>

            <!-- The island and its two curved shoulders, drawn as one smooth shape (see UpdateIslandShape).
                 Its fill, edge and glow come from the island style chosen in Settings. -->
            <Path x:Name="IslandShape" Fill="Black" />

            <Border x:Name="Island" Margin="14,0" Background="Transparent" CornerRadius="0,0,17,17"
                    SizeChanged="Island_SizeChanged">

                <Border.ContextMenu>
                    <ContextMenu Opened="Menu_Opened" Closed="Menu_Closed">
                        <MenuItem x:Name="StartWithWindowsMenuItem" Header="Start with Windows" IsCheckable="True" Click="StartWithWindows_Click" />
                        <MenuItem x:Name="ShowTaskbarMenuItem" Header="Show the Windows taskbar" IsCheckable="True" Click="ShowTaskbarMenu_Click" />
                        <Separator />
                        <MenuItem Header="Exit Dynamic Island" Click="Exit_Click" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid x:Name="IslandContent" ClipToBounds="True">

                    <!-- ============ COMPACT: the little pill you see most of the time ============ -->
                    <Grid x:Name="CompactContent" Margin="16,0,14,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="CompactClock" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="CompactDate" FontSize="11.5" Foreground="{StaticResource SubtleText}" Margin="9,1,0,0" VerticalAlignment="Center" />
                            <StackPanel x:Name="CompactBattery" Orientation="Horizontal" Margin="10,1,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Grid Width="21" Height="10" VerticalAlignment="Center">
                                    <Border BorderBrush="#B3FFFFFF" BorderThickness="1" CornerRadius="2.5" Margin="0,0,2,0" />
                                    <Border Width="1.5" Height="4" HorizontalAlignment="Right" Background="#B3FFFFFF" CornerRadius="0.75" />
                                    <Border x:Name="CompactBatteryFill" Background="White" CornerRadius="1.2" Margin="2,2,0,2" HorizontalAlignment="Left" Width="0" />
                                </Grid>
                                <TextBlock x:Name="CompactBatteryBolt" Style="{StaticResource Glyph}" FontSize="9" Text="&#xE945;" Margin="3,0,0,0"
                                           Foreground="{DynamicResource Accent}" Visibility="Collapsed" />
                                <TextBlock x:Name="CompactBatteryText" FontSize="11" Foreground="{StaticResource SubtleText}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Little dancing bars, only while music is playing -->
                        <StackPanel x:Name="EqBars" Orientation="Horizontal" Width="18" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Visibility="Hidden">
                            <Rectangle Width="2.5" Height="11" Margin="1.25,0" RadiusX="1.25" RadiusY="1.25" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Eq1" ScaleY="0.5" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="2.5" Height="11" Margin="1.25,0" RadiusX="1.25" RadiusY="1.25" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Eq2" ScaleY="0.8" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="2.5" Height="11" Margin="1.25,0" RadiusX="1.25" RadiusY="1.25" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Eq3" ScaleY="0.4" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                    </Grid>

                    <!-- ============ PEEK: hover the pill to see your open apps ============ -->
                    <StackPanel x:Name="PeekContent" Margin="16,9,16,14" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Visibility="Collapsed" Opacity="0">
                        <Grid Height="22" Margin="2,0,2,6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="PeekTime" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="PeekDate" FontSize="11" Foreground="{StaticResource SubtleText}" Margin="8,1,0,0" VerticalAlignment="Center" />
                            <StackPanel x:Name="PeekBattery" Orientation="Horizontal" Margin="10,1,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Grid Width="21" Height="10" VerticalAlignment="Center">
                                    <Border BorderBrush="#B3FFFFFF" BorderThickness="1" CornerRadius="2.5" Margin="0,0,2,0" />
                                    <Border Width="1.5" Height="4" HorizontalAlignment="Right" Background="#B3FFFFFF" CornerRadius="0.75" />
                                    <Border x:Name="PeekBatteryFill" Background="White" CornerRadius="1.2" Margin="2,2,0,2" HorizontalAlignment="Left" Width="0" />
                                </Grid>
                                <TextBlock x:Name="PeekBatteryBolt" Style="{StaticResource Glyph}" FontSize="9" Text="&#xE945;" Margin="3,0,0,0"
                                           Foreground="{DynamicResource Accent}" Visibility="Collapsed" />
                                <TextBlock x:Name="PeekBatteryText" FontSize="11" Foreground="{StaticResource SubtleText}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="PeekEqBars" Orientation="Horizontal" Width="18" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Visibility="Hidden">
                                <Rectangle Width="2.5" Height="11" Margin="1.25,0" RadiusX="1.25" RadiusY="1.25" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><ScaleTransform x:Name="Eq4" ScaleY="0.5" /></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="2.5" Height="11" Margin="1.25,0" RadiusX="1.25" RadiusY="1.25" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><ScaleTransform x:Name="Eq5" ScaleY="0.8" /></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="2.5" Height="11" Margin="1.25,0" RadiusX="1.25" RadiusY="1.25" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><ScaleTransform x:Name="Eq6" ScaleY="0.4" /></Rectangle.RenderTransform>
                                </Rectangle>
                            </StackPanel>
                        </Grid>
                        <!-- Now playing: one quiet line (art · title — artist · controls) with a hairline progress bar -->
                        <StackPanel x:Name="PeekMediaRow" Margin="8,0,8,8" Visibility="Collapsed" MinWidth="270" MaxWidth="400">
                            <Grid Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PeekMediaArt" Width="18" Height="18" CornerRadius="4" Background="#22FFFFFF" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11.5">
                                    <Run x:Name="PeekMediaTitle" FontWeight="SemiBold" />
                                    <Run x:Name="PeekMediaArtist" Foreground="#8CFFFFFF" />
                                </TextBlock>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IslandButton}" Width="22" Height="22" Click="Previous_Click" ToolTip="Previous">
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="9" Text="&#xE892;" Foreground="#B3FFFFFF" />
                                    </Button>
                                    <Button Style="{StaticResource IslandButton}" Width="24" Height="22" Margin="1,0" Click="PlayPause_Click" ToolTip="Play / pause">
                                        <TextBlock x:Name="PeekPlayGlyph" Style="{StaticResource Glyph}" FontSize="11" Text="&#xE768;" Foreground="{DynamicResource Accent}" />
                                    </Button>
                                    <Button Style="{StaticResource IslandButton}" Width="22" Height="22" Click="Next_Click" ToolTip="Next">
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="9" Text="&#xE893;" Foreground="#B3FFFFFF" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="PeekProgress" Height="2" Margin="0,4,0,0" Visibility="Collapsed">
                                <Border Background="#1FFFFFFF" CornerRadius="1" />
                                <Border Background="{DynamicResource Accent}" CornerRadius="1" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="PeekProgressScale" ScaleX="0" /></Border.RenderTransform>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <!-- Now using: the app in front with its window title, the other open apps as icons on the right -->
                        <Border x:Name="PeekNowRow" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="4,3,6,3" Margin="2,0"
                                MinWidth="300" MaxWidth="420">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PeekActiveButton" Style="{StaticResource PeekButton}" Click="AppTile_Click"
                                        MouseEnter="Tile_MouseEnter" MouseLeave="Tile_MouseLeave" HorizontalContentAlignment="Stretch">
                                    <Border x:Name="PeekActiveBg" CornerRadius="9" Padding="6,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#12FFFFFF" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="22" Height="22" VerticalAlignment="Center">
                                                <Image x:Name="PeekActiveImage" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock x:Name="PeekActiveGlyph" FontSize="20" FontFamily="{x:Static local:LineIcons.FontOrDefault}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis">
                                                <Run x:Name="PeekActiveName" FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="PeekActiveTitle" Foreground="#80FFFFFF" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Button>
                                <ItemsControl x:Name="PeekAppsList" Grid.Column="1" ItemTemplate="{StaticResource SmallAppIconTemplate}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ============ ACTIVITY: brief pop-outs (volume, new song, charging…) ============ -->
                    <Grid x:Name="ActivityContent" Margin="18,4,24,8" Visibility="Collapsed" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="36" Height="36" VerticalAlignment="Center">
                            <TextBlock x:Name="ActivityGlyph" Style="{StaticResource Glyph}" FontSize="20" />
                            <Border x:Name="ActivityArt" CornerRadius="9" Visibility="Collapsed" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ActivityTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ActivitySub" FontSize="11" Foreground="#A0FFFFFF" TextTrimming="CharacterEllipsis" />
                            <Grid x:Name="ActivityBar" Height="4" Margin="0,6,0,0" Visibility="Collapsed">
                                <Border Background="#33FFFFFF" CornerRadius="2" />
                                <Border Background="{DynamicResource Accent}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="ActivityBarScale" ScaleX="0" /></Border.RenderTransform>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ============ EXPANDED: tabs ============ -->
                    <StackPanel x:Name="ExpandedContent" Width="620" Margin="20,8,20,20"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Visibility="Collapsed" Opacity="0">

                        <!-- Header: Start + Search | tabs | battery + clock -->
                        <Grid Height="38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IslandButton}" Width="32" Height="34" Click="Settings_Click" ToolTip="Settings">
                                    <TextBlock x:Name="SettingsGlyph" Style="{StaticResource Glyph}" FontSize="14" Text="&#xE713;" />
                                </Button>
                                <Button Style="{StaticResource IslandButton}" Width="32" Height="34" Click="Search_Click" ToolTip="Search apps">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="&#xE721;" />
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <RadioButton x:Name="TodayTabButton" Style="{StaticResource TabButton}" Content="Today" Tag="Today" Checked="Tab_Checked" />
                                <RadioButton x:Name="ControlsTabButton" Style="{StaticResource TabButton}" Content="Controls" Tag="Controls" Checked="Tab_Checked" />
                                <RadioButton x:Name="AppsTabButton" Style="{StaticResource TabButton}" Content="Apps" Tag="Apps" Checked="Tab_Checked" />
                                <RadioButton x:Name="ClipboardTabButton" Style="{StaticResource TabButton}" Content="Clipboard" Tag="Clipboard" Checked="Tab_Checked" />
                                <RadioButton x:Name="ShelfTabButton" Style="{StaticResource TabButton}" Content="Shelf" Tag="Shelf" Checked="Tab_Checked" />
                                <RadioButton x:Name="MediaTabButton" Style="{StaticResource TabButton}" Content="Media" Tag="Media" Checked="Tab_Checked" />
                                <RadioButton x:Name="StatsTabButton" Style="{StaticResource TabButton}" Content="Stats" Tag="Stats" Checked="Tab_Checked" />
                                <RadioButton x:Name="PowerTabButton" Style="{StaticResource TabButton}" Content="Power" Tag="Power" Checked="Tab_Checked" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed">
                                    <TextBlock x:Name="BatteryText" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <Grid Width="23" Height="11" VerticalAlignment="Center">
                                        <Border BorderBrush="#C0FFFFFF" BorderThickness="1" CornerRadius="3" Margin="0,0,2,0" />
                                        <Border Width="2" Height="4" HorizontalAlignment="Right" Background="#C0FFFFFF" CornerRadius="1" />
                                        <Border x:Name="BatteryFill" Background="White" CornerRadius="1.5" Margin="2,2,0,2"
                                                HorizontalAlignment="Left" Width="0" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock x:Name="BigClock" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="DateText" FontSize="10" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">

                            <!-- ======================= CONTROLS ======================= -->
                            <Grid x:Name="ControlsTab">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: switches -->
                                <Border Style="{StaticResource Card}" Padding="5,5">
                                    <StackPanel x:Name="SwitchList" />
                                </Border>

                                <!-- Right: player, volume, shortcuts -->
                                <StackPanel Grid.Column="2">
                                    <Border x:Name="MiniMediaCard" Style="{StaticResource Card}">
                                        <Grid>
                                            <StackPanel x:Name="MiniMediaFull" Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="MiniArt" Width="42" Height="42" CornerRadius="10" Background="#22FFFFFF" />
                                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="MiniTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="MiniArtist" FontSize="11" Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="MiniMediaOutput" FontSize="10" Foreground="#66FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid x:Name="MiniProgressRow" Margin="0,9,0,0" Visibility="Collapsed">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="MiniElapsed" FontSize="10" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center" MinWidth="28" />
                                                    <Slider x:Name="MiniProgress" Grid.Column="1" Style="{StaticResource SlimSlider}" Margin="6,0" Minimum="0" Maximum="1"
                                                            PreviewMouseLeftButtonDown="MediaProgress_MouseDown" PreviewMouseLeftButtonUp="MediaProgress_MouseUp" />
                                                    <TextBlock x:Name="MiniDuration" Grid.Column="2" FontSize="10" Foreground="{StaticResource SubtleText}"
                                                               VerticalAlignment="Center" MinWidth="28" TextAlignment="Right" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                    <Button Style="{StaticResource IslandButton}" Width="32" Height="32" Click="Previous_Click" ToolTip="Previous">
                                                        <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE892;" />
                                                    </Button>
                                                    <Button Style="{StaticResource PlayButton}" Width="36" Height="36" Margin="10,0" Click="PlayPause_Click" ToolTip="Play / pause">
                                                        <TextBlock x:Name="MiniPlayGlyph" Style="{StaticResource Glyph}" FontSize="13" Text="&#xE768;" />
                                                    </Button>
                                                    <Button Style="{StaticResource IslandButton}" Width="32" Height="32" Click="Next_Click" ToolTip="Next">
                                                        <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE893;" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel x:Name="MiniMediaEmpty" Orientation="Horizontal" Margin="0,4">
                                                <Border Width="42" Height="42" CornerRadius="10" Background="#14FFFFFF">
                                                    <TextBlock Style="{StaticResource Glyph}" FontSize="15" Text="&#xE8D6;" Foreground="#66FFFFFF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Nothing playing" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="Music and videos show up here" FontSize="11" Foreground="{StaticResource SubtleText}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,10,0,0">
                                        <Slider x:Name="ControlsVolume" Style="{StaticResource BigSlider}" Minimum="0" Maximum="100"
                                                SmallChange="2" LargeChange="10" ValueChanged="VolumeSlider_ValueChanged" />
                                        <TextBlock x:Name="ControlsVolumeGlyph" Style="{StaticResource Glyph}" FontSize="13" Text="&#xE767;"
                                                   HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="{DynamicResource AccentText}" IsHitTestVisible="False" />
                                        <TextBlock x:Name="ControlsVolumeText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False" />
                                    </Grid>

                                    <UniformGrid Columns="2" Margin="-4,6,-4,0">
                                        <Button Style="{StaticResource CardButton}" Padding="10,8" Tag="ms-settings:" Click="Launch_Click" ToolTip="Open Windows Settings">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE713;" Foreground="{DynamicResource Accent}" />
                                                <TextBlock Text="Settings" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource CardButton}" Padding="10,8" Click="QuickSettings_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE9E9;" />
                                                <TextBlock Text="Quick settings" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource CardButton}" Padding="10,8" Click="Notifications_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE91C;" />
                                                <TextBlock Text="Notifications" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource CardButton}" Padding="10,8" Click="Tray_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TrayGlyph" Style="{StaticResource Glyph}" FontSize="12" Text="&#xE70E;" />
                                                <TextBlock x:Name="TrayChipText" Text="Tray icons" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Grid>

                            <!-- ======================= TODAY ======================= -->
                            <!-- Three cards side by side: the clock, the weather (with the next few hours) and the month -->
                            <Grid x:Name="TodayTab" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="158" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="214" />
                                </Grid.ColumnDefinitions>

                                <!-- Clock -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="GreetingText" FontSize="11.5" Foreground="{StaticResource SubtleText}" />
                                        <TextBlock x:Name="TodayTime" FontSize="34" FontWeight="SemiBold" Margin="0,2,0,-2" />
                                        <TextBlock x:Name="TodayDay" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                        <TextBlock x:Name="TodayDate" FontSize="11.5" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TodayExtra" FontSize="10" Foreground="{StaticResource SubtleText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Weather -->
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <Grid>
                                        <StackPanel x:Name="WeatherPanel" Visibility="Collapsed" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="WeatherSymbol" FontFamily="Segoe UI Symbol" FontSize="30" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="WeatherTemp" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,-3" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="WeatherCondition" FontSize="11.5" Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                                        <TextBlock Text="  ·  " FontSize="11.5" Foreground="{StaticResource SubtleText}" />
                                                        <TextBlock x:Name="WeatherHighLow" FontSize="11.5" Foreground="{StaticResource SubtleText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock x:Name="WeatherPlace" Grid.Column="2" FontSize="10.5" Foreground="{StaticResource SubtleText}" VerticalAlignment="Top"
                                                           MaxWidth="90" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <UniformGrid x:Name="WeatherHours" Columns="5" Margin="0,14,0,0" />
                                        </StackPanel>
                                        <StackPanel x:Name="WeatherMessagePanel" VerticalAlignment="Center">
                                            <TextBlock x:Name="WeatherMessage" Text="Loading weather…" FontSize="12" Foreground="{StaticResource SubtleText}"
                                                       TextWrapping="Wrap" TextAlignment="Center" />
                                            <Button x:Name="WeatherSetupButton" Style="{StaticResource CardButton}" Padding="12,6" Margin="0,10,0,0"
                                                    HorizontalAlignment="Center" Click="WeatherSetup_Click" Visibility="Collapsed">
                                                <TextBlock Text="Set your town" FontSize="11.5" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Month -->
                                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="10,8,10,8" MouseWheel="Calendar_MouseWheel">
                                    <StackPanel>
                                        <DockPanel Margin="2,0,0,4">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource IslandButton}" Width="24" Height="24" Click="PreviousMonth_Click" ToolTip="Previous month">
                                                    <TextBlock Style="{StaticResource Glyph}" FontSize="9" Text="&#xE76B;" />
                                                </Button>
                                                <Button Style="{StaticResource IslandButton}" Height="24" Click="ThisMonth_Click" ToolTip="Back to this month">
                                                    <TextBlock Text="Today" FontSize="10.5" Margin="6,0" />
                                                </Button>
                                                <Button Style="{StaticResource IslandButton}" Width="24" Height="24" Click="NextMonth_Click" ToolTip="Next month">
                                                    <TextBlock Style="{StaticResource Glyph}" FontSize="9" Text="&#xE76C;" />
                                                </Button>
                                            </StackPanel>
                                            <TextBlock x:Name="MonthTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <UniformGrid x:Name="WeekdayHeader" Columns="7" Margin="0,0,0,2" />
                                        <UniformGrid x:Name="CalendarGrid" Columns="7" Rows="6" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ======================= APPS ======================= -->
                            <StackPanel x:Name="AppsTab" Visibility="Collapsed">
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="14" Height="40" Margin="0,0,0,4">
                                    <Grid Margin="14,0,14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE721;" Foreground="{StaticResource SubtleText}" />
                                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Margin="10,0,0,0" Text="Search apps…"
                                                   Foreground="#66FFFFFF" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                        <TextBox x:Name="SearchBox" Grid.Column="1" Margin="7,0,0,0" Background="Transparent" BorderThickness="0"
                                                 Foreground="White" CaretBrush="White" SelectionBrush="#88D6B46A" FontSize="13"
                                                 VerticalAlignment="Center" TextChanged="Search_TextChanged" PreviewKeyDown="Search_KeyDown" />
                                        <TextBlock Grid.Column="2" Text="↑↓  Enter" FontSize="10.5" Foreground="#4DFFFFFF" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Your open apps, small, for quick switching -->
                                <!-- Your open apps as chips, for quick switching -->
                                <ItemsControl x:Name="AppsOpenChips" ItemTemplate="{StaticResource OpenChipTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}" Margin="2,10,0,0" Visibility="Collapsed" />

                                <!-- Faded top and bottom edges, smooth scrolling, rows that glide in (see MainWindow.xaml.cs) -->
                                <!-- Smooth scrolling and rows that glide in: see MainWindow.Apps.cs.
                                     The soft fades at the top and bottom are overlays (much cheaper than masking the list). -->
                                <Grid>
                                    <ScrollViewer x:Name="AppsScroller" MaxHeight="400" Focusable="False"
                                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="AppsScroller_PreviewMouseWheel" ScrollChanged="AppsScroller_ScrollChanged">
                                        <StackPanel>
                                            <ItemsControl x:Name="AppsList" MouseLeave="AppsList_MouseLeave">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <!-- Rows start invisible and are faded in as they scroll into view -->
                                                        <Setter Property="Opacity" Value="0" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>
                                            <TextBlock x:Name="AppsStatus" FontSize="12" Foreground="#80FFFFFF" Margin="12,8,0,12" Visibility="Collapsed" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Rectangle x:Name="AppsFadeTop" Height="18" VerticalAlignment="Top" IsHitTestVisible="False"
                                               Fill="{DynamicResource ListFadeTop}" Visibility="Collapsed" />
                                    <Rectangle x:Name="AppsFadeBottom" Height="26" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                               Fill="{DynamicResource ListFadeBottom}" />
                                </Grid>
                            </StackPanel>

                            <!-- ======================= CLIPBOARD ======================= -->
                            <StackPanel x:Name="ClipboardTab" Visibility="Collapsed">
                                <!-- Search + filters -->
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="14" Height="40">
                                    <Grid Margin="14,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE721;" Foreground="{StaticResource SubtleText}" />
                                        <TextBlock x:Name="ClipSearchPlaceholder" Grid.Column="1" Margin="10,0,0,0" Text="Search…"
                                                   Foreground="#66FFFFFF" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                        <TextBox x:Name="ClipSearchBox" Grid.Column="1" Margin="7,0,0,0" Background="Transparent" BorderThickness="0"
                                                 Foreground="White" CaretBrush="White" SelectionBrush="#88D6B46A" FontSize="13"
                                                 VerticalAlignment="Center" TextChanged="ClipSearch_TextChanged" PreviewKeyDown="ClipSearch_KeyDown" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="ClipFilterAll" Style="{StaticResource ChipRadio}" GroupName="ClipFilter" Content="All" Tag="All" IsChecked="True" Checked="ClipFilter_Checked" />
                                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="ClipFilter" Content="Text" Tag="Text" Checked="ClipFilter_Checked" />
                                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="ClipFilter" Content="Images" Tag="Images" Checked="ClipFilter_Checked" />
                                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="ClipFilter" Content="Links" Tag="Links" Checked="ClipFilter_Checked" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- List | detail -->
                                <Grid Margin="0,10,0,0" Height="292">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="292" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ScrollViewer x:Name="ClipScroller" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <ItemsControl x:Name="ClipList" />
                                            <StackPanel x:Name="ClipEmpty" Margin="0,40,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="26" Text="&#xE8C8;" Foreground="#55FFFFFF" />
                                                <TextBlock x:Name="ClipEmptyText" Text="Nothing copied yet" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                                <TextBlock Text="Password-manager copies are skipped." FontSize="11" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0" Padding="16,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Hidden">
                                                <Grid>
                                                    <TextBlock x:Name="ClipDetailText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               TextAlignment="Center" LineHeight="19" />
                                                    <Image x:Name="ClipDetailImage" MaxHeight="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </ScrollViewer>
                                            <StackPanel x:Name="ClipDetailMeta" Grid.Row="1">
                                                <Border Height="1" Background="#14FFFFFF" Margin="0,10,0,8" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Type" FontSize="11" Foreground="{StaticResource SubtleText}" Margin="0,2" />
                                                    <TextBlock x:Name="ClipDetailType" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Margin="0,2" />
                                                    <TextBlock Grid.Row="1" Text="Size" FontSize="11" Foreground="{StaticResource SubtleText}" Margin="0,2" />
                                                    <TextBlock x:Name="ClipDetailSize" Grid.Row="1" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Margin="0,2" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="2" Text="Copied" FontSize="11" Foreground="{StaticResource SubtleText}" Margin="0,2" />
                                                    <TextBlock x:Name="ClipDetailCopied" Grid.Row="2" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Margin="0,2" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Shortcuts (also clickable) -->
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="↑↓ Move  ·  Tab Filter" FontSize="10.5" Foreground="#66FFFFFF" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource KeyHint}" Tag="↵" Click="ClipPaste_Click">Paste</Button>
                                        <Button Style="{StaticResource KeyHint}" Tag="Ctrl C" Click="ClipCopy_Click">Copy</Button>
                                        <Button Style="{StaticResource KeyHint}" Tag="Ctrl P" Click="ClipPin_Click">
                                            <TextBlock x:Name="ClipPinText" Text="Pin" />
                                        </Button>
                                        <Button Style="{StaticResource KeyHint}" Tag="Del" Click="ClipRemove_Click">Remove</Button>
                                        <Button Style="{StaticResource KeyHint}" Tag="Win V" Click="WindowsClipboard_Click">Windows</Button>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>

                            <!-- ======================= SHELF ======================= -->
                            <StackPanel x:Name="ShelfTab" Visibility="Collapsed">
                                <DockPanel Margin="6,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="ShelfDragAllButton" Style="{StaticResource CardButton}" Padding="12,6" Margin="4,0" Cursor="SizeAll"
                                                PreviewMouseLeftButtonDown="ShelfTile_MouseDown" PreviewMouseMove="ShelfDragAll_MouseMove"
                                                ToolTip="Drag this to move or copy every file at once">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE7C2;" />
                                                <TextBlock Text="Drag all" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource CardButton}" Padding="12,6" Margin="4,0,0,0" Click="ShelfClear_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE74D;" />
                                                <TextBlock Text="Clear" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="ShelfTitle" Text="SHELF" FontSize="10.5" FontWeight="SemiBold" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer MaxHeight="360" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="ShelfList" ItemTemplate="{StaticResource ShelfTileTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                                </ScrollViewer>
                                <Border x:Name="ShelfEmpty" BorderBrush="#33FFFFFF" BorderThickness="1.5" CornerRadius="18" Height="170" Margin="0,2,0,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="28" Text="&#xE8B7;" Foreground="#66FFFFFF" />
                                        <TextBlock Text="Drop files on the island to keep them here" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                        <TextBlock Text="Then drag them back out into any folder, email or app." FontSize="11.5"
                                                   Foreground="{StaticResource SubtleText}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================= SETTINGS ======================= -->
                            <!-- Sections down the left, the chosen section's settings on the right -->
                            <Grid x:Name="SettingsTab" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="6" VerticalAlignment="Top">
                                    <StackPanel>
                                        <RadioButton x:Name="SettingsNavAppearance" Style="{StaticResource NavRadio}" GroupName="SettingsSection" IsChecked="True" Checked="SettingsSection_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE790;" VerticalAlignment="Center" />
                                                <TextBlock Text="Appearance" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="SettingsNavBehaviour" Style="{StaticResource NavRadio}" GroupName="SettingsSection" Checked="SettingsSection_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE8B0;" VerticalAlignment="Center" />
                                                <TextBlock Text="Behaviour" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="SettingsNavWeather" Style="{StaticResource NavRadio}" GroupName="SettingsSection" Checked="SettingsSection_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE753;" VerticalAlignment="Center" />
                                                <TextBlock Text="Weather" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="SettingsNavAbout" Style="{StaticResource NavRadio}" GroupName="SettingsSection" Checked="SettingsSection_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE946;" VerticalAlignment="Center" />
                                                <TextBlock Text="About" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,10">
                                    <Grid>
                                        <StackPanel x:Name="SettingsAppearance">
                                            <DockPanel Margin="0,2,0,6">
                                                <StackPanel x:Name="AccentSwatches" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Accent colour" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Highlights, switches and the music bars" FontSize="10.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,6">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton x:Name="StyleBlack" Style="{StaticResource ChipRadio}" GroupName="IslandStyle" Content="Black" Tag="Black" Click="SettingChanged" />
                                                    <RadioButton x:Name="StyleGlass" Style="{StaticResource ChipRadio}" GroupName="IslandStyle" Content="Glass" Tag="Glass" Click="SettingChanged" />
                                                    <RadioButton x:Name="StyleGlow" Style="{StaticResource ChipRadio}" GroupName="IslandStyle" Content="Glow" Tag="Glow" Click="SettingChanged" />
                                                    <RadioButton x:Name="StyleOutline" Style="{StaticResource ChipRadio}" GroupName="IslandStyle" Content="Outline" Tag="Outline" Click="SettingChanged" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Island style" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Black, frosted glass, a soft glow or a thin outline" FontSize="10.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,6">
                                                <CheckBox x:Name="LineIconsSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="SettingChanged" />
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Line icons" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="LineIconsStatusText" Text="Tidy, matching icons for your apps instead of their own icons" FontSize="10.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,6">
                                                <CheckBox x:Name="BatterySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="SettingChanged" />
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Battery on the island" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="BatteryStatusText" Text="Show the battery level next to the date (laptops and tablets)" FontSize="10.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,6">
                                                <CheckBox x:Name="MusicBarsSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="SettingChanged" />
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Music bars" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Little dancing bars on the island while something plays" FontSize="10.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="SettingsBehaviour" Visibility="Collapsed">
                                            <DockPanel Margin="0,2,0,6">
                                                <CheckBox x:Name="PeekSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="SettingChanged" />
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Show open apps on hover" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Rest the mouse on the island to see and switch apps" FontSize="10.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,6">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton x:Name="DelayQuick" Style="{StaticResource ChipRadio}" GroupName="PeekDelay" Content="Quick" Tag="250" Click="SettingChanged" />
                                                    <RadioButton x:Name="DelayNormal" Style="{StaticResource ChipRadio}" GroupName="PeekDelay" Content="Normal" Tag="450" Click="SettingChanged" />
                                                    <RadioButton x:Name="DelayRelaxed" Style="{StaticResource ChipRadio}" GroupName="PeekDelay" Content="Relaxed" Tag="750" Click="SettingChanged" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Hover delay" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="How long to rest the mouse before it opens" FontSize="10.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,6">
                                                <CheckBox x:Name="HideMaximizedSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="SettingChanged" />
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Tuck away over maximised apps" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Rest the mouse at the top of the screen to bring it back" FontSize="10.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,6">
                                                <CheckBox x:Name="DevicePopOutsSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="SettingChanged" />
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Device pop-ups" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Bluetooth devices, USB drives and headphones connecting" FontSize="10.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,6">
                                                <CheckBox x:Name="SearchHotkeySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="SettingChanged" />
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Ctrl+Space opens app search" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SearchHotkeyStatusText" Text="From anywhere: type an app's name and press Enter. Press it again to close" FontSize="10.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,6">
                                                <CheckBox x:Name="StartWithWindowsSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="SettingChanged" />
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Start with Windows" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="StartupStatusText" Text="Opens when you sign in, and again when you reconnect or unlock if it isn't running" FontSize="10.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Button x:Name="StartupFixButton" Style="{StaticResource CardButton}" Padding="12,6" Margin="0,2,0,4"
                                                    HorizontalAlignment="Left" Click="StartupFix_Click" Visibility="Collapsed">
                                                <TextBlock Text="Open Windows startup settings" FontSize="11.5" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel x:Name="SettingsWeather" Visibility="Collapsed">
                                            <TextBlock Text="Your town" FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,2" />
                                            <TextBlock Text="Leave it empty to use your PC's location" FontSize="10.5" Foreground="{StaticResource SubtleText}" Margin="0,0,0,8" />
                                            <Border Background="#FF222222" CornerRadius="10" Height="34">
                                                <Grid Margin="10,0">
                                                    <TextBlock x:Name="PlacePlaceholder" Text="e.g. London" Foreground="#66FFFFFF"
                                                               FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    <TextBox x:Name="PlaceBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                                             FontSize="12" VerticalAlignment="Center" TextChanged="PlaceBox_TextChanged" PreviewKeyDown="PlaceBox_KeyDown" />
                                                </Grid>
                                            </Border>
                                            <DockPanel Margin="0,8,0,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource CardButton}" Padding="12,6" Margin="0" Click="SavePlace_Click">
                                                    <TextBlock Text="Save location" FontSize="11.5" />
                                                </Button>
                                                <TextBlock x:Name="PlaceStatus" FontSize="11" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,6">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton x:Name="CelsiusChip" Style="{StaticResource ChipRadio}" GroupName="Units" Content="°C" Click="SettingChanged" />
                                                    <RadioButton x:Name="FahrenheitChip" Style="{StaticResource ChipRadio}" GroupName="Units" Content="°F" Click="SettingChanged" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Temperature" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Celsius or Fahrenheit" FontSize="10.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="SettingsAbout" Visibility="Collapsed">
                                            <TextBlock Text="Dynamic Island for Windows" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            <TextBlock x:Name="AboutVersionText" FontSize="11" Foreground="{StaticResource SubtleText}" />
                                            <TextBlock Text="An iPhone-style island that replaces the Windows taskbar." FontSize="11" Foreground="{StaticResource SubtleText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                            <WrapPanel Margin="-4,12,0,0">
                                                <Button Style="{StaticResource CardButton}" Padding="12,7" Click="OpenLogFolder_Click">
                                                    <TextBlock Text="Open error log folder" FontSize="11.5" />
                                                </Button>
                                                <Button Style="{StaticResource CardButton}" Padding="12,7" Click="OpenProjectPage_Click">
                                                    <TextBlock Text="Project page" FontSize="11.5" />
                                                </Button>
                                                <Button Style="{StaticResource CardButton}" Padding="12,7" Click="Exit_Click">
                                                    <TextBlock Text="Quit and restore taskbar" FontSize="11.5" />
                                                </Button>
                                            </WrapPanel>
                                            <TextBlock FontSize="10.5" Foreground="#66FFFFFF" Margin="0,12,0,0" TextWrapping="Wrap"
                                                       Text="If something goes wrong, the details are saved in errors.log in that folder." />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ======================= MEDIA ======================= -->
                            <Border x:Name="MediaTab" Visibility="Collapsed" CornerRadius="22" Padding="16,16,16,14" Margin="-6,-4,-6,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop x:Name="MediaGlowStrong" Color="#00000000" Offset="0" />
                                        <GradientStop x:Name="MediaGlowSoft" Color="#00000000" Offset="0.45" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <StackPanel x:Name="MediaEmpty" Margin="0,24,0,20" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="28" Text="&#xE8D6;" Foreground="#55FFFFFF" HorizontalAlignment="Center" />
                                        <TextBlock Text="Nothing playing" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                        <TextBlock Text="Play music or a video and it'll appear here" FontSize="11.5"
                                                   Foreground="{StaticResource SubtleText}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Grid x:Name="MediaFull" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BigArt" Width="136" Height="136" CornerRadius="18" Background="#22FFFFFF" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="BigSource" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="BigTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <TextBlock x:Name="BigArtist" FontSize="13" Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" />
                                            <Grid x:Name="BigProgressRow" Margin="0,12,0,0" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="BigElapsed" FontSize="10.5" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center" MinWidth="30" />
                                                <Slider x:Name="BigProgress" Grid.Column="1" Style="{StaticResource SlimSlider}" Margin="8,0" Minimum="0" Maximum="1"
                                                        PreviewMouseLeftButtonDown="MediaProgress_MouseDown" PreviewMouseLeftButtonUp="MediaProgress_MouseUp" />
                                                <TextBlock x:Name="BigDuration" Grid.Column="2" FontSize="10.5" Foreground="{StaticResource SubtleText}"
                                                           VerticalAlignment="Center" MinWidth="30" TextAlignment="Right" />
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="ShuffleButton" Style="{StaticResource IslandButton}" Width="32" Height="32" Click="Shuffle_Click" ToolTip="Shuffle">
                                                        <TextBlock x:Name="ShuffleGlyph" Style="{StaticResource Glyph}" FontSize="13" Text="&#xE8B1;" />
                                                    </Button>
                                                    <Button Style="{StaticResource IslandButton}" Width="38" Height="38" Margin="4,0,0,0" Click="Previous_Click" ToolTip="Previous">
                                                        <TextBlock Style="{StaticResource Glyph}" FontSize="15" Text="&#xE892;" />
                                                    </Button>
                                                    <Button x:Name="BigPlayButton" Style="{StaticResource TintPlayButton}" Width="46" Height="46" Margin="8,0" Click="PlayPause_Click" ToolTip="Play / pause">
                                                        <TextBlock x:Name="BigPlayGlyph" Style="{StaticResource Glyph}" FontSize="17" Text="&#xE768;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Button>
                                                    <Button Style="{StaticResource IslandButton}" Width="38" Height="38" Margin="0,0,4,0" Click="Next_Click" ToolTip="Next">
                                                        <TextBlock Style="{StaticResource Glyph}" FontSize="15" Text="&#xE893;" />
                                                    </Button>
                                                    <Button x:Name="RepeatButton" Style="{StaticResource IslandButton}" Width="32" Height="32" Click="Repeat_Click" ToolTip="Repeat">
                                                        <TextBlock x:Name="RepeatGlyph" Style="{StaticResource Glyph}" FontSize="13" Text="&#xE8EE;" />
                                                    </Button>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IslandButton}" Width="30" Height="30" Click="Mute_Click" ToolTip="Mute / unmute">
                                                        <TextBlock x:Name="MediaVolumeGlyph" Style="{StaticResource Glyph}" FontSize="13" Text="&#xE767;" />
                                                    </Button>
                                                    <Slider x:Name="MediaVolume" Style="{StaticResource SlimSlider}" Width="96" Margin="4,0,2,0"
                                                            Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" VerticalAlignment="Center"
                                                            ValueChanged="VolumeSlider_ValueChanged" />
                                                    <Button Style="{StaticResource IslandButton}" Height="30" Click="OutputPicker_Click"
                                                            ToolTip="Choose speakers or headphones">
                                                        <StackPanel Orientation="Horizontal" Margin="8,0">
                                                            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE7F5;" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="MediaOutputText" FontSize="11" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center"
                                                                       MaxWidth="86" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ======================= STATS ======================= -->
                            <StackPanel x:Name="StatsTab" Visibility="Collapsed">
                                <UniformGrid Columns="4" Margin="-4,0">
                                    <Border Style="{StaticResource Card}" Margin="4" Padding="8,14,8,12">
                                        <StackPanel>
                                            <Grid Width="84" Height="84" HorizontalAlignment="Center">
                                                <Ellipse Stroke="#1FFFFFFF" StrokeThickness="7" />
                                                <Path x:Name="CpuRing" Stroke="{DynamicResource Accent}" StrokeThickness="7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CpuText" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="CPU" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0" />
                                            <TextBlock x:Name="CpuSub" FontSize="10.5" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="4" Padding="8,14,8,12">
                                        <StackPanel>
                                            <Grid Width="84" Height="84" HorizontalAlignment="Center">
                                                <Ellipse Stroke="#1FFFFFFF" StrokeThickness="7" />
                                                <Path x:Name="MemRing" Stroke="{DynamicResource Accent}" StrokeThickness="7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="MemText" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Memory" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0" />
                                            <TextBlock x:Name="MemSub" FontSize="10.5" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="4" Padding="8,14,8,12">
                                        <StackPanel>
                                            <Grid Width="84" Height="84" HorizontalAlignment="Center">
                                                <Ellipse Stroke="#1FFFFFFF" StrokeThickness="7" />
                                                <Path x:Name="DiskRing" Stroke="{DynamicResource Accent}" StrokeThickness="7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="DiskText" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="DiskLabel" Text="Disk" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0" />
                                            <TextBlock x:Name="DiskSub" FontSize="10.5" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="4" Padding="8,14,8,12">
                                        <StackPanel>
                                            <Grid Width="84" Height="84" HorizontalAlignment="Center">
                                                <Ellipse Stroke="#1FFFFFFF" StrokeThickness="7" />
                                                <Path x:Name="NetDownRing" Stroke="{DynamicResource Accent}" StrokeThickness="7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="NetDownText" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="NetUnitText" FontSize="10" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Download" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0" />
                                            <TextBlock x:Name="NetDownSub" FontSize="10.5" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10,10,10,8">
                                    <StackPanel>
                                        <Grid Margin="6,0,6,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="HEAVIEST OPEN APPS" FontSize="10.5" FontWeight="SemiBold" Foreground="#80FFFFFF" />
                                                <TextBlock x:Name="UptimeText" FontSize="10.5" Foreground="#55FFFFFF" Margin="10,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="CPU" FontSize="10.5" FontWeight="SemiBold" Foreground="#80FFFFFF" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="MEMORY" FontSize="10.5" FontWeight="SemiBold" Foreground="#80FFFFFF" TextAlignment="Right" />
                                        </Grid>
                                        <ItemsControl x:Name="TopAppsList" ItemTemplate="{StaticResource AppUsageTemplate}" />
                                        <TextBlock x:Name="TopAppsEmpty" Text="No apps open right now" FontSize="12" Foreground="{StaticResource SubtleText}"
                                                   Margin="6,6,6,4" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================= POWER ======================= -->
                            <StackPanel x:Name="PowerTab" Visibility="Collapsed">
                                <!-- One line of facts: four equal columns, each centred, so the spacing is always even -->
                                <Border Style="{StaticResource Card}" Padding="4,2">
                                    <UniformGrid Columns="4">
                                        <Button Style="{StaticResource CardButton}" Background="Transparent" Margin="2" Padding="6,9" ToolTip="How long since this PC was last restarted">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="PowerUptimeGlyph" Style="{StaticResource Glyph}" FontSize="13" Text="&#xE916;" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="PowerUptimeValue" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="PowerUptimeSub" FontSize="11.5" Foreground="#73FFFFFF" Margin="5,0,0,0" VerticalAlignment="Center"
                                                           MaxWidth="80" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource CardButton}" Background="Transparent" Margin="2" Padding="6,9" Tag="ms-settings:windowsupdate" Click="Launch_Click" ToolTip="Open Windows Update">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="PowerUpdateGlyph" Style="{StaticResource Glyph}" FontSize="13" Text="&#xE896;" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="PowerUpdateValue" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="PowerUpdateSub" FontSize="11.5" Foreground="#73FFFFFF" Margin="5,0,0,0" VerticalAlignment="Center"
                                                           MaxWidth="80" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource CardButton}" Background="Transparent" Margin="2" Padding="6,9" Tag="ms-settings:powersleep" Click="Launch_Click" ToolTip="Power and battery settings">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="PowerBatteryGlyph" Style="{StaticResource Glyph}" FontSize="13" Text="&#xE83E;" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="PowerBatteryValue" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="PowerBatterySub" FontSize="11.5" Foreground="#73FFFFFF" Margin="5,0,0,0" VerticalAlignment="Center"
                                                           MaxWidth="80" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource CardButton}" Background="Transparent" Margin="2" Padding="6,9" Click="PowerShowApps_Click" ToolTip="See open apps">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="PowerAppsGlyph" Style="{StaticResource Glyph}" FontSize="13" Text="&#xE71D;" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="PowerAppsValue" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="PowerAppsSub" FontSize="11.5" Foreground="#73FFFFFF" Margin="5,0,0,0" VerticalAlignment="Center"
                                                           MaxWidth="80" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </Border>

                                <!-- Small round buttons, then the two sliders -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource RoundCardButton}" Width="44" Height="44" Margin="0,0,8,0" Tag="lock" Click="Power_Click" ToolTip="Lock (Win + L)">
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="15" Text="&#xE72E;" />
                                    </Button>
                                    <Button Style="{StaticResource RoundCardButton}" Width="44" Height="44" Margin="0,0,8,0" Tag="sleep" Click="Power_Click" ToolTip="Sleep">
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="15" Text="&#xE708;" />
                                    </Button>
                                    <Button x:Name="SignOutButton" Style="{StaticResource RoundCardButton}" Width="44" Height="44" Margin="0,0,8,0" Tag="signout" Click="Power_Click" ToolTip="Sign out">
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="15" Text="&#xE77B;" />
                                    </Button>
                                    </StackPanel>
                                    <Border x:Name="RestartSlideHost" Grid.Column="1" />
                                    <Border x:Name="ShutDownSlideHost" Grid.Column="3" />
                                </Grid>
                                <TextBlock x:Name="PowerHint" FontSize="11" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Center" Margin="0,7,0,0" Height="15" />

                                <!-- Quick launch as small chips -->
                                <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                                    <TextBlock Text="OPEN" FontSize="10.5" FontWeight="SemiBold" Foreground="#73FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource CardButton}" Padding="11,6" Margin="0,0,6,0" Tag="taskmgr" Click="Launch_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE9D9;" VerticalAlignment="Center" />
                                            <TextBlock Text="Task Manager" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CardButton}" Padding="11,6" Margin="0,0,6,0" Tag="ms-settings:" Click="Launch_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE713;" VerticalAlignment="Center" />
                                            <TextBlock Text="Settings" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CardButton}" Padding="11,6" Margin="0,0,6,0" Tag="explorer.exe" Click="Launch_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE8B7;" VerticalAlignment="Center" />
                                            <TextBlock Text="File Explorer" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CardButton}" Padding="11,6" Margin="0,0,6,0" Tag="desktop" Click="Launch_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE80F;" VerticalAlignment="Center" />
                                            <TextBlock Text="Desktop" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
